from datetime import datetime, timezone

from fastapi import APIRouter, BackgroundTasks, Depends, HTTPException, Request, Response
from fastapi.responses import HTMLResponse
from sqlalchemy import delete, select
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session

from app.core.config import get_settings
from app.db.session import get_db
from app.models.auth import LoginSession, User
from app.schemas.auth import (
    Credentials, EmailRequest, MessageResponse, RegisterRequest,
    ResetPasswordRequest, TokenRequest, UserResponse,
)
from app.services.auth.email_actions import consume_email_action, issue_email_action, notify_password_changed
from app.services.auth.pages import action_page
from app.services.auth.rate_limit import (
    allow_email_request, client_ip, enforce_limit, limit_login,
)
from app.services.auth.security import (
    COOKIE_NAME, clear_session_cookie, dummy_hash, hash_token,
    new_session_token, password_hasher, set_session_cookie,
)


def protect_write(request: Request):
    if request.method in {"GET", "HEAD", "OPTIONS"}:
        return
    origin = request.headers.get("origin")
    if origin is not None and origin not in get_settings().allowed_origins:
        raise HTTPException(403, "Origin not allowed")
    if request.headers.get("X-Trace-Client") != "web":
        raise HTTPException(403, "Missing client protection header")


router = APIRouter(
    prefix="/auth", tags=["Authentication"],
    dependencies=[Depends(protect_write)],
)


@router.post("/register", response_model=UserResponse, status_code=201)
def register(
    body: RegisterRequest, request: Request, background_tasks: BackgroundTasks,
    db: Session = Depends(get_db),
):
    enforce_limit("register-ip", client_ip(request), 10, 3600)
    may_send = allow_email_request(request, "verify_email", str(body.email))
    user = User(
        email=str(body.email), name=body.name,
        password_hash=password_hasher.hash(body.password),
        email_verified=False,
    )
    db.add(user)
    try:
        db.commit()
    except IntegrityError:
        db.rollback()
        raise HTTPException(409, "An account with this email already exists") from None
    # Count registration's first verification mail in the resend quota.
    if may_send:
        background_tasks.add_task(issue_email_action, user.email, "verify_email")
    return user


@router.post("/login", response_model=UserResponse)
def login(
    body: Credentials, request: Request, response: Response,
    db: Session = Depends(get_db),
):
    limit_login(request, str(body.email))
    # Same user lock as reset. Old-password login cannot commit a new session
    # after a concurrent reset revoked sessions.
    user = db.scalar(select(User).where(
        User.email == str(body.email)
    ).with_for_update())
    stored_hash = user.password_hash if user and user.password_hash else dummy_hash
    valid_password = password_hasher.verify(body.password, stored_hash)
    if user is None or not user.password_hash or not valid_password:
        raise HTTPException(401, "Invalid email or password")
    if not user.email_verified:
        raise HTTPException(403, "Verify your email before signing in")
    old_token = request.cookies.get(COOKIE_NAME)
    if old_token:
        db.execute(delete(LoginSession).where(
            LoginSession.token_hash == hash_token(old_token)
        ))
    token, expires = new_session_token()
    db.add(LoginSession(
        user_id=user.id, token_hash=hash_token(token), expires_at=expires
    ))
    db.commit()
    set_session_cookie(response, token)
    return user


@router.get("/me", response_model=UserResponse)
def current_user(request: Request, db: Session = Depends(get_db)):
    token = request.cookies.get(COOKIE_NAME)
    if not token or len(token) > 128:
        raise HTTPException(401, "Not signed in")
    user = db.scalar(select(User).join(
        LoginSession, LoginSession.user_id == User.id
    ).where(
        LoginSession.token_hash == hash_token(token),
        LoginSession.expires_at > datetime.now(timezone.utc),
        User.email_verified.is_(True),
    ))
    if user is None:
        raise HTTPException(401, "Session expired or invalid")
    return user


@router.post("/logout", status_code=204)
def logout(request: Request, response: Response, db: Session = Depends(get_db)):
    token = request.cookies.get(COOKIE_NAME)
    if token:
        db.execute(delete(LoginSession).where(
            LoginSession.token_hash == hash_token(token)
        ))
        db.commit()
    clear_session_cookie(response)


@router.post("/email/verification-request", response_model=MessageResponse, status_code=202)
def request_verification(
    body: EmailRequest, request: Request, background_tasks: BackgroundTasks,
):
    if allow_email_request(request, "verify_email", str(body.email)):
        background_tasks.add_task(issue_email_action, str(body.email), "verify_email")
    return {"message": "If this account needs verification, an email will be sent."}


@router.post("/email/verify", response_model=MessageResponse)
def verify_email(body: TokenRequest, request: Request):
    enforce_limit("verify-token-ip", client_ip(request), 30, 900)
    consume_email_action(body.token, "verify_email")
    return {"message": "Email verified. Sign in to continue."}


@router.post("/password/forgot", response_model=MessageResponse, status_code=202)
def forgot_password(
    body: EmailRequest, request: Request, background_tasks: BackgroundTasks,
):
    if allow_email_request(request, "reset_password", str(body.email)):
        background_tasks.add_task(issue_email_action, str(body.email), "reset_password")
    return {"message": "If this account has a password, a reset email will be sent."}


@router.post("/password/reset", response_model=MessageResponse)
def reset_password(
    body: ResetPasswordRequest, request: Request, response: Response,
    background_tasks: BackgroundTasks,
):
    enforce_limit("reset-token-ip", client_ip(request), 10, 900)
    email = consume_email_action(body.token, "reset_password", body.new_password)
    clear_session_cookie(response)
    background_tasks.add_task(notify_password_changed, email)
    return {"message": "Password changed. Sign in with your new password."}


@router.get("/verify-email", response_class=HTMLResponse)
def verify_email_page():
    return action_page(reset=False)


@router.get("/reset-password", response_class=HTMLResponse)
def reset_password_page():
    return action_page(reset=True)
